{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "useDefineForClassFields": true,
    "skipLibCheck": true,

    /* Modulo y empaquetador */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Alias de importación (sin baseUrl) */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Tipos globales (Vitest + Web Bluetooth para impresión ESC/POS) */
    "types": ["vitest/globals", "web-bluetooth"],

    /* Linting y verificación de tipos recomendada */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"]
}